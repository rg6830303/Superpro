# SuperPro Pickleball — environment variables.
# Copy to .env.local for local dev; set the same keys in Vercel for both the
# user deployment and the admin deployment.
# NEVER commit real values. Only NEXT_PUBLIC_* reach the browser — never put a
# secret behind that prefix.

# ── Database (Supabase Postgres) ─────────────────────────────────────────────
# MUST be the Supabase *Transaction pooler* string (…pooler.supabase.com:6543).
# The direct :5432 connection exhausts the connection limit on serverless.
POSTGRES_URL=

# Supabase REST/Storage — used for admin product-image uploads (optional).
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=superpro-media

# ── Auth / sessions ──────────────────────────────────────────────────────────
SESSION_SECRET=            # 32+ random chars — signs JWT session cookies. openssl rand -hex 32
ADMIN_EMAIL=               # admin console login email
ADMIN_PASSWORD_HASH=       # bcrypt hash (cost >= 12) of the admin password
# ADMIN_PASSWORD=          # plaintext bootstrap fallback — remove once the hash is set

# ── Deployment split ─────────────────────────────────────────────────────────
# Host that serves the ADMIN console. On that host "/" redirects to /admin and
# the public site is unreachable; on every other host /admin 404s.
# Leave blank for single-domain local dev.
NEXT_PUBLIC_ADMIN_HOST=
NEXT_PUBLIC_SITE_URL=https://superpro.in

# ── WhatsApp ─────────────────────────────────────────────────────────────────
# Sales/support representative — powers every "Chat with a rep" button (wa.me).
NEXT_PUBLIC_WHATSAPP_NUMBER=919163132551
NEXT_PUBLIC_WHATSAPP_GROUP_URL=      # public invite link to the daily-games group
# Optional WhatsApp Cloud API — when set, confirmed slots post to the group
# automatically. Without it the admin console gives a one-tap "share to group"
# link instead (WhatsApp has no public API for posting into a group chat).
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GROUP_JID=
# Generic relay fallback (e.g. an n8n / Zapier / self-hosted bridge webhook).
WHATSAPP_WEBHOOK_URL=
WHATSAPP_WEBHOOK_SECRET=

# ── Payments (Razorpay) ──────────────────────────────────────────────────────
# Without these the checkout still works and falls back to "pay at venue".
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── Misc ─────────────────────────────────────────────────────────────────────
CRON_SECRET=               # protects /api/cron/* (Vercel sends it as a Bearer token)
SEED_TOKEN=                # protects /api/db-init seeding
